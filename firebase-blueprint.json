{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "REDZONE application",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "secret": { "type": "string" },
        "ownerid": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "totalUsers": { "type": "number" },
        "activeLicenses": { "type": "number" },
        "downloadLink": { "type": "string" }
      }
    },
    "LicenseKey": {
      "title": "LicenseKey",
      "description": "License key entity",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "appId": { "type": "string" },
        "durationDays": { "type": "number" },
        "level": { "type": "number" },
        "status": { "type": "string" },
        "usedBy": { "type": "string" },
        "usedAt": { "type": "string" },
        "hwid": { "type": "string" },
        "createdAt": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "AuthUser": {
      "title": "AuthUser",
      "description": "Authenticated user entity",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "appId": { "type": "string" },
        "hwid": { "type": "string" },
        "ip": { "type": "string" },
        "created": { "type": "string" },
        "lastLogin": { "type": "string" },
        "banned": { "type": "boolean" },
        "banReason": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/applications/{appId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Applications collection"
    },
    "/licenses/{licenseId}": {
      "schema": { "$ref": "#/entities/LicenseKey" },
      "description": "License keys collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/AuthUser" },
      "description": "Users collection"
    }
  },
  "securityRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
